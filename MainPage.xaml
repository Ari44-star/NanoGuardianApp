<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:NanoGuardian.App.ViewModels"
             x:Class="NanoGuardian.App.MainPage"
             Title="Nano-Guardian Dashboard">

    <ContentPage.BindingContext>
        <viewmodels:DashboardViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Image Source="dotnet_bot.png" HeightRequest="150" HorizontalOptions="Center" />

        <Label Text="Paciente:" FontSize="18" FontAttributes="Bold" />
        <Label Text="{Binding AlertaActual.Paciente}" FontSize="24" TextColor="DarkBlue" />

        <Label Text="Fuerza de Impacto (G):" FontSize="18" FontAttributes="Bold" />
        <Label Text="{Binding AlertaActual.FuerzaImpactoG}" FontSize="24" TextColor="DarkRed" />

        <Label Text="Estado del Sistema:" FontSize="18" FontAttributes="Bold" />
        <Label Text="{Binding AlertaActual.Estado}" FontSize="24" TextColor="Green" />
    </VerticalStackLayout>

</ContentPage>